import Cogentic.ModularPowerCost
import Cogentic.Concrete

namespace Cogentic.BinarySaturation
open BinaryDivision BinaryPivot BinaryModularPower

private theorem quotient_length (d x : List Bool) : (divide d x).quotient.length=x.length := by
  induction x with
  | nil => rfl
  | cons b x ih => simp [divide,ih]

private theorem lcmUpto_next (k : ℕ) : (k+1).lcmUpto = (k+1).lcm k.lcmUpto := by
  have interval : Finset.Icc 1 (k+1) = insert (k+1) (Finset.Icc 1 k) := by
    ext i; simp; omega
  simp [Nat.lcmUpto,interval]; rfl

/-- The cursor is generated by ripple-carry increment. Multiplying the old
lcm by the next cursor divided by its gcd keeps all updates exact. -/
structure State where
  cursor : List Bool
  common : List Bool
  gates : ℕ

def advance (s : State) : State :=
  let next := addDigits s.cursor.length s.cursor [] true
  let g := gcdBits next.1 s.common
  let q := divide g.1 next.1
  let product := multiply s.common q.quotient
  ⟨next.1,product.1,s.gates+next.2+g.2+q.gates+product.2⟩

def rangeLCM : ℕ → State
  | 0 => ⟨[],[true],0⟩
  | k+1 => advance (rangeLCM k)

def stepBudget (w : ℕ) := 5*w+gcdBudget w+w*(20*w+1)+16*w^2

private theorem step_mono {w W : ℕ} (h : w≤W) : stepBudget w ≤ stepBudget W := by
  unfold stepBudget gcdBudget; gcongr

theorem rangeLCM_spec (k : ℕ) :
    let s := rangeLCM k
    value s.cursor=k ∧ s.cursor.length=k ∧ value s.common=k.lcmUpto ∧
      s.common.length≤(k+1)^2 ∧ s.gates≤k*stepBudget ((k+1)^2) := by
  induction k with
  | zero => simp [rangeLCM,value,Nat.lcmUpto]
  | succ k ih =>
    let s := rangeLCM k
    obtain ⟨cursor,clen,common,len,cost⟩ := ih
    let w := (k+2)^2
    let next := addDigits s.cursor.length s.cursor [] true
    let g := gcdBits next.1 s.common
    let q := divide g.1 next.1
    let p := multiply s.common q.quotient
    have ⟨nl,nc,nv⟩ := addDigits_spec s.cursor.length s.cursor [] true le_rfl (by simp)
    change next.1.length=_ at nl
    change next.2=_ at nc
    change value next.1=value s.cursor+0+1 at nv
    change s.cursor.length=k at clen
    change value s.cursor=k at cursor
    change value s.common=k.lcmUpto at common
    change s.common.length≤(k+1)^2 at len
    change s.gates≤k*stepBudget ((k+1)^2) at cost
    rw [clen] at nl nc
    rw [cursor,Nat.add_zero] at nv
    have wk : k+1≤w := by dsimp [w]; nlinarith
    have ws : (k+1)^2 ≤w := Nat.pow_le_pow_left (by omega) 2
    have nw := nl.le.trans wk
    have sw := len.trans ws
    obtain ⟨gv,gl,gc⟩ := gcdBits_spec next.1 s.common w nw sw
    change value g.1=_ at gv
    change g.1.length≤w at gl
    change g.2≤_ at gc
    rw [nv,common] at gv gc
    have gp : 0<value g.1 := gv ▸ Nat.gcd_pos_of_pos_left _ (by omega)
    obtain ⟨_,_,eq,small,qc⟩ := divide_spec g.1 next.1 gp
    change value next.1=value q.quotient*value g.1+value q.remainder at eq
    change value q.remainder<value g.1 at small
    have qv : value q.quotient=(k+1)/value g.1 := by
      rw [←nv,eq,Nat.mul_comm (value q.quotient),Nat.mul_add_div gp,Nat.div_eq_of_lt small,Nat.add_zero]
    have ql : q.quotient.length=k+1 := (quotient_length ..).trans nl
    obtain ⟨pv,pl,pc⟩ := multiply_spec s.common q.quotient
    change value p.1=_ at pv
    change p.1.length≤_ at pl
    change p.2≤_ at pc
    rw [qv,gv,common] at pv
    rw [ql] at pl pc
    have cnt := (Elimination.gcdWithCount_le (k+1) k.lcmUpto).trans (Nat.mul_le_mul_left 2
      (show (k+1).size≤w from (Nat.size_le.mpr (nv ▸ value_lt next.1)).trans nw))
    have gcdCost : g.2≤gcdBudget w := gc.trans (by unfold gcdBudget; gcongr)
    have qCost : q.gates≤w*(20*w+1) := qc.trans (by apply Nat.mul_le_mul nw; omega)
    have pCost : p.2≤16*w^2 := pc.trans (calc
      _ ≤ w*(w+5*(w+2*w)) := by gcongr
      _ = _ := by ring)
    change value next.1 = k+1 ∧ next.1.length=k+1 ∧ value p.1=(k+1).lcmUpto ∧ p.1.length≤w ∧
      s.gates+next.2+g.2+q.gates+p.2≤(k+1)*stepBudget w
    refine ⟨nv,nl,?_,pl.trans (by dsimp [w]; nlinarith only [len]),?_⟩
    · rw [pv,lcmUpto_next,Nat.lcm_comm (k+1),Nat.lcm,Nat.mul_div_assoc _ (Nat.gcd_dvd_right ..),Nat.gcd_comm]
      exact Nat.mul_comm ..
    · have prev := cost.trans (Nat.mul_le_mul_left k (step_mono ws))
      have step : next.2+g.2+q.gates+p.2 ≤ stepBudget w := by
        rw [nc]; unfold stepBudget
        omega
      rw [Nat.succ_mul]; omega

/-- Remove high zeroes, tracking whether the higher suffix is empty. -/
def canonical : List Bool → List Bool × ℕ
  | [] => ([],0)
  | b::bs =>
    let t := canonical bs
    if t.1.isEmpty && !b then ([],t.2+3) else (b::t.1,t.2+3)

theorem canonical_spec (xs : List Bool) :
    (canonical xs).1=(value xs).bits ∧ (canonical xs).2=3*xs.length := by
  induction xs with
  | nil => simp [canonical,value]
  | cons b bs ih =>
    rcases ih with ⟨tail,work⟩
    by_cases z : value bs=0
    · cases b <;> simp [canonical,tail,work,value,z,Nat.mul_succ]
    · have no : (value bs).bits.isEmpty=false := by
        apply List.isEmpty_eq_false_iff.mpr
        intro h
        have hv := congrArg value h
        exact z (by simpa [value] using hv)
      cases b <;> simp [canonical,tail,work,value,no,Nat.mul_succ,z]
      rw [Nat.add_comm]; exact (Nat.bit1_bits _).symm

/-- Expand binary loop fuel with a linear number of list operations. -/
def tokens : List Bool → List Unit × ℕ
  | [] => ([],0)
  | b::bs =>
    let t := tokens bs
    let d := t.1++t.1
    (if b then ()::d else d,t.2+t.1.length+2)

theorem token_spec (bs : List Bool) :
    (tokens bs).1.length=value bs ∧ (tokens bs).2≤value bs+2*bs.length := by
  induction bs with
  | nil => simp [tokens,value]
  | cons b bs ih =>
    cases b <;> simp [tokens,ih.1,value] <;> omega

def run : List Unit → State
  | [] => ⟨[],[true],0⟩
  | _::rest => advance (run rest)

private theorem run_eq (ts : List Unit) : run ts=rangeLCM ts.length := by
  induction ts with
  | nil => rfl
  | cons u ts ih => simp [run,rangeLCM,ih]

def budget (cap e : ℕ) :=
  let w := (cap+1)^2
  cap+2*cap.size+cap*(stepBudget w+1)+e*(w+5*(w+2*e))+3*(w+2*e)

/-- Given the binary cap used by the presieve, build the canonical binary
word of the saturated exponent, including the loop and normalization scans. -/
def build (e cap : List Bool) : List Bool × ℕ :=
  let t := tokens cap
  let r := run t.1
  let product := multiply r.common e
  let out := canonical product.1
  (out.1,t.2+t.1.length+r.gates+product.2+out.2)

theorem build_spec (e : List Bool) (b β : ℕ) :
    let k := indexCap b β
    let out := build e k.bits
    out.1=(saturate (value e) b β).bits ∧ out.2≤budget k e.length := by
  intro k out
  let t := tokens k.bits
  let r := run t.1
  let w := (k+1)^2
  have ⟨tl,tw⟩ := token_spec k.bits
  change t.1.length=_ at tl
  change t.2≤_ at tw
  rw [value_bits] at tl tw
  rw [Nat.size_eq_bits_len] at tw
  have eq : r=rangeLCM k := (run_eq _).trans (by rw [tl])
  obtain ⟨_,_,v,len,cost⟩ := rangeLCM_spec k
  change value (rangeLCM k).common=_ at v
  rw [←eq] at v len cost
  obtain ⟨num,pl,work⟩ := multiply_spec r.common e
  have ⟨digits,finish⟩ := canonical_spec (multiply r.common e).1
  change (canonical (multiply r.common e).1).1=_ ∧
    t.2+t.1.length+r.gates+(multiply r.common e).2+(canonical (multiply r.common e).1).2≤_
  refine ⟨digits.trans (by rw [num,v]; rfl),?_⟩
  rw [finish,tl]
  change r.common.length≤w at len
  have product := work.trans (show _≤e.length*(w+5*(w+2*e.length)) by gcongr)
  have endLength := pl.trans (Nat.add_le_add_right len (2*e.length))
  unfold budget
  change r.gates≤k*stepBudget w at cost
  change _ ≤ k+2*k.size+k*(stepBudget w+1)+e.length*(w+5*(w+2*e.length))+3*(w+2*e.length)
  rw [Nat.mul_add k (stepBudget _) 1,Nat.mul_one]
  dsimp only [w] at *
  omega

/-- The cap and accepted exponent widths from the fixed schedule put the
saturation circuit inside one exponential in the two-thirds scale. -/
theorem budget_scale {b e : ℕ} (hb : 0<b)
    (he : e≤2^(2017*TwoThirdsCost.scale b)+1) :
    budget (indexCap b (Fixed.beta b)) e ≤ 2^(8079*TwoThirdsCost.scale b) := by
  let s := TwoThirdsCost.scale b
  let k := indexCap b (Fixed.beta b)
  let X := 2^(2018*s)
  have ds := Fixed.degree_pos hb
  have vs : Fixed.v b ≤ s := (Fixed.scale_bounds hb).1
  have hs : Fixed.h b ≤ s := (Nat.le_mul_of_pos_left _ ds).trans vs
  have sp : 0<s := (Nat.mul_pos ds (Nat.succ_pos _)).trans_le hs
  have small : k≤2^(1001*s) := (Fixed.index_bound hb).trans (Nat.pow_le_pow_right (by decide)
    (by unfold Fixed.beta; omega))
  have double (a : ℕ) : 2^a+1≤2^(a+1) := by
    rw [pow_succ]; have := Nat.two_pow_pos a; omega
  have next : k+1≤2^(1002*s) := (Nat.add_le_add_right small 1).trans
    ((double _).trans (Nat.pow_le_pow_right (by decide) (by omega)))
  have wX : (k+1)^2≤X := (Nat.pow_le_pow_left next 2).trans (by
    rw [←pow_mul]; exact Nat.pow_le_pow_right (by decide) (by omega))
  have kX : k≤X := small.trans (Nat.pow_le_pow_right (by decide) (by omega))
  have eX : e≤X := he.trans ((double _).trans (Nat.pow_le_pow_right (by decide) (by omega)))
  have sizeX : k.size≤X := (Nat.size_le.mpr (Nat.lt_two_pow_self (n:=k))).trans kX
  have xp : 0<X := by dsimp [X]; positivity
  have XX : X≤X^4 := Nat.le_self_pow (by decide) X
  have sq : X^2≤X^4 := Nat.pow_le_pow_right xp (by decide)
  have cube : X^3≤X^4 := Nat.pow_le_pow_right xp (by decide)
  calc
    budget k e ≤ X+2*X+X*(stepBudget X+1)+X*(X+5*(X+2*X))+3*(X+2*X) := by
      dsimp only [budget]
      have :=  step_mono wX
      gcongr
    _ ≤ 128*X^4 := by unfold stepBudget gcdBudget; nlinarith only [XX,sq,cube,Nat.zero_le (X^4)]
    _ ≤ 2^(8079*s) := by
      change 2^7*(2^(2018*s))^4≤_
      rw [←pow_mul,←pow_add]
      exact Nat.pow_le_pow_right (by decide) (by omega)

/-- On the concrete accepted-orders branch, the resulting bit word can be
passed directly to the splitter. -/
theorem driver_saturation (n : ℕ) (hn : 2≤n) :
    let b := n.log2+1
    match (TwoThirdsSearch.collect hn (TwoThirdsSearch.searchBox n
      (2*b^2*Fixed.U b*Fixed.A b) (2*b^2*Fixed.U b) (Concrete.candidate n))
      (dyadicTargets (Fixed.beta b)).sort).1 with
    | .divisor .. => True
    | .orders e .. =>
      let out := build e.bits (indexCap b (Fixed.beta b)).bits
      out.1=(saturate e b (Fixed.beta b)).bits ∧ out.2≤2^(8079*TwoThirdsCost.scale b) := by
  let b := n.log2+1
  let res := (TwoThirdsSearch.collect hn (TwoThirdsSearch.searchBox n
    (2*b^2*Fixed.U b*Fixed.A b) (2*b^2*Fixed.U b) (Concrete.candidate n))
    (dyadicTargets (Fixed.beta b)).sort).1
  change match res with
    | .divisor .. => True
    | .orders e .. => _
  have upper := TryPair.saturated_size Construction.construct Concrete.arch n hn
  change (match res with
    | .divisor .. => True
    | .orders e .. => saturate e b (Fixed.beta b) ≤ 2^(2^(2017*TwoThirdsCost.scale b))) at upper
  cases h : res with
  | divisor => trivial
  | orders e big even kept valid =>
    rw [h] at upper
    have small : e ≤ saturate e b (Fixed.beta b) := Nat.le_mul_of_pos_right _ (Nat.lcmUpto_pos _)
    have width := (Nat.size_le_size (small.trans upper)).trans_eq Nat.size_pow
    obtain ⟨v,c⟩ := build_spec e.bits b (Fixed.beta b)
    simp only [value_bits,Nat.size_eq_bits_len] at v c
    exact ⟨v,c.trans (budget_scale (Nat.succ_pos _) width)⟩

end Cogentic.BinarySaturation
