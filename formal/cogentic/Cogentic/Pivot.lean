import Cogentic.AffineValuations
import Mathlib.Data.Fintype.Perm
import Mathlib.LinearAlgebra.Matrix.Rank

/-! Integer pivot solutions and bounded kernel columns for the two-field extractor. -/

open scoped BigOperators Matrix NumberField Polynomial
open Matrix NumberField
namespace Cogentic

variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- For integer incidence matrices the permutation formula gives a factorial bound
without computing real norms. It applies as well to every replaced Cramer column. -/
theorem incidence_det_bound (B : Matrix ι ι ℤ) (bound : ∀ i j, |B i j| ≤ 1) :
    |B.det| ≤ (Fintype.card ι).factorial := by
  classical
  rw [Matrix.det_apply']
  calc
    _ ≤ ∑ σ : Equiv.Perm ι, |(Equiv.Perm.sign σ : ℤ) * ∏ i, B (σ i) i| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _ : Equiv.Perm ι, (1 : ℤ) := by
      apply Finset.sum_le_sum
      intro σ _
      have one : |(Equiv.Perm.sign σ : ℤ)| = 1 := (Int.isUnit_iff_abs_eq.mp (Equiv.Perm.sign σ).isUnit)
      rw [abs_mul, one, one_mul, Finset.abs_prod]
      calc
        _ ≤ ∏ _i : ι, (1 : ℤ) := Finset.prod_le_prod (fun i _ => abs_nonneg _)
          (fun i _ => bound _ _)
        _ = 1 := by simp
    _ = _ := by simp [Fintype.card_perm]

theorem incidence_cramer_bound (B : Matrix ι ι ℤ) (hB : ∀ i j, |B i j| ≤ 1)
    (b : ι → ℤ) (hb : ∀ i, |b i| ≤ 1) (i : ι) :
    |B.cramer b i| ≤ (Fintype.card ι).factorial := by
  rw [Matrix.cramer_apply]
  apply incidence_det_bound
  intro j k
  by_cases h : k = i
  · subst k; simpa using hb j
  · simpa [Matrix.updateCol_ne h] using hB j k

/-- The columns of this integer matrix insert coefficients into their selected
pivot positions, with zero in every other position. -/
def pivotSelector (pick : ι → κ) : Matrix κ ι ℤ := fun j i => if j = pick i then 1 else 0

omit [Fintype ι] [DecidableEq ι] in
theorem mul_pivotSelector {τ : Type*} (A : Matrix τ κ ℤ) (pick : ι → κ) :
    A * pivotSelector pick = A.submatrix id pick := by
  ext i j
  simp [Matrix.mul_apply, pivotSelector, mul_ite]

/-- The adjugate kernel matrix includes a zero column at every chosen pivot. -/
def pivotKernel (A : Matrix ι κ ℤ) (pick : ι → κ) : Matrix κ κ ℤ :=
  let B := A.submatrix id pick
  B.det • (1 : Matrix κ κ ℤ) - pivotSelector pick * B.adjugate * A

theorem mul_pivotKernel (A : Matrix ι κ ℤ) (pick : ι → κ) :
    A * pivotKernel A pick = 0 := by
  let B := A.submatrix id pick
  change A * (B.det • (1 : Matrix κ κ ℤ) - pivotSelector pick * B.adjugate * A) = 0
  rw [Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, ← Matrix.mul_assoc,
    ← Matrix.mul_assoc, mul_pivotSelector, Matrix.mul_adjugate, Matrix.smul_mul, Matrix.one_mul, sub_self]

/-- Every integer null vector is generated by the computed integer columns
after multiplying once by the pivot determinant. -/
theorem pivotKernel_mulVec (A : Matrix ι κ ℤ) (pick : ι → κ) (z : κ → ℤ)
    (zero : A *ᵥ z = 0) :
    pivotKernel A pick *ᵥ z = (A.submatrix id pick).det • z := by
  rw [pivotKernel, Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec,
    zero, Matrix.mulVec_zero, sub_zero]

omit [Fintype κ] [DecidableEq ι] in
private theorem selector_bound (pick : ι → κ) (x : ι → ℤ) {T : ℤ} (hT : 0 ≤ T)
    (hx : ∀ i, |x i| ≤ T) (j : κ) : |(pivotSelector pick *ᵥ x) j| ≤ Fintype.card ι * T := by
  change |∑ i, (if j = pick i then (1 : ℤ) else 0) * x i| ≤ _
  calc
    _ ≤ ∑ i, |(if j = pick i then (1 : ℤ) else 0) * x i| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : ι, T := Finset.sum_le_sum (fun i _ => by
      split_ifs <;> simp [hx i, hT])
    _ = _ := by simp

omit [Fintype κ] in
/-- Bounds each computed null column, including all cofactor products. -/
theorem pivotKernel_bound (A : Matrix ι κ ℤ) (hA : ∀ i j, |A i j| ≤ 1) (pick : ι → κ) (j k : κ) :
    |pivotKernel A pick j k| ≤ (Fintype.card ι + 1 : ℤ) * (Fintype.card ι).factorial := by
  let B := A.submatrix id pick
  let t := (Fintype.card ι).factorial
  have ht : (0 : ℤ) ≤ t := by positivity
  have bnd (i j) : |B i j| ≤ 1 := hA i (pick j)
  have det : |B.det| ≤ t := incidence_det_bound B bnd
  have corr := selector_bound pick (B.cramer (fun i => A i k)) ht
    (incidence_cramer_bound B bnd _ (fun i => hA i k)) j
  have eq : (pivotSelector pick * B.adjugate * A) j k =
      (pivotSelector pick *ᵥ B.cramer (fun i => A i k)) j := by
    rw [Matrix.cramer_eq_adjugate_mulVec, Matrix.mulVec_mulVec]
    rfl
  change |B.det * (1 : Matrix κ κ ℤ) j k - (pivotSelector pick * B.adjugate * A) j k| ≤ _
  rw [eq]
  have diag : |B.det * (1 : Matrix κ κ ℤ) j k| ≤ t := by
    by_cases e : j = k
    · subst k; simpa using det
    · simp [Matrix.one_apply_ne e, ht]
  exact (abs_sub _ _).trans (by dsimp [t] at *; linarith [corr])


/-- A single square pivot gives the positive target multiplier and the
computed integer solution, with uniform bounds on every coefficient. -/
theorem bounded_pivot_target (A : Matrix ι κ ℤ) (hA : ∀ i j, |A i j| ≤ 1) (pick : ι → κ)
    (nonzero : (A.submatrix id pick).det ≠ 0) (b : ι → ℤ) (hb : ∀ i, |b i| ≤ 1) :
    ∃ (e : ℕ) (c : κ → ℤ), 0 < e ∧ e ≤ (Fintype.card ι).factorial ∧
      (∀ j, |c j| ≤ (Fintype.card ι : ℤ) * (Fintype.card ι).factorial) ∧
      A *ᵥ c = -(e : ℤ) • b := by
  let B := A.submatrix id pick
  let x := pivotSelector pick *ᵥ B.cramer b
  have bnd (i j) : |B i j| ≤ 1 := hA i (pick j)
  have he : B.det.natAbs ≤ (Fintype.card ι).factorial := by
    have le := incidence_det_bound B bnd
    rwa [Int.abs_eq_natAbs, Int.ofNat_le] at le
  have hx (j) : |x j| ≤ (Fintype.card ι : ℤ) * (Fintype.card ι).factorial :=
    selector_bound pick _ (by positivity) (incidence_cramer_bound B bnd b hb) j
  have target : A *ᵥ x = B.det • b := by
    rw [show x = pivotSelector pick *ᵥ B.cramer b from rfl, Matrix.mulVec_mulVec, mul_pivotSelector,
      Matrix.mulVec_cramer]
  have pos : 0 < B.det.natAbs := Int.natAbs_pos.mpr nonzero
  by_cases h : 0 ≤ B.det
  · refine ⟨B.det.natAbs, -x, pos, he, fun j => by simpa using hx j, ?_⟩
    rw [Matrix.mulVec_neg, target, Int.natCast_natAbs, abs_of_nonneg h, neg_smul]
  · refine ⟨B.det.natAbs, x, pos, he, hx, ?_⟩
    rw [target, Int.natCast_natAbs, abs_of_neg (lt_of_not_ge h), neg_neg]

/-- Any real span obtained from the entire integer kernel is already obtained
from the finite list of adjugate columns, because the pivot determinant is nonzero. -/
theorem pivot_columns_span {ν : Type*} (A : Matrix ι κ ℤ) (pick : ι → κ)
    (nonzero : (A.submatrix id pick).det ≠ 0) (U : Matrix ν κ ℝ)
    (span : Submodule.span ℝ {y : ν → ℝ | ∃ z : κ → ℤ, A *ᵥ z = 0 ∧
      y = U *ᵥ (fun j => (z j : ℝ))} = ⊤) :
    Submodule.span ℝ (Set.range (fun j => U *ᵥ
      (fun k => (pivotKernel A pick k j : ℝ)))) = ⊤ := by
  classical
  let D := pivotKernel A pick
  let δ := (A.submatrix id pick).det
  let S := Submodule.span ℝ (Set.range (fun j => U *ᵥ (fun k => (D k j : ℝ))))
  change S = ⊤
  rw [← top_le_iff, ← span]
  apply Submodule.span_le.mpr
  rintro _ ⟨z, hz, rfl⟩
  let x (j) : ℝ := z j
  have comb : ∑ j, x j • (fun k => (D k j : ℝ)) = (δ : ℝ) • x := by
    funext k
    have h := congrFun (pivotKernel_mulVec A pick z hz) k
    change ∑ j, D k j * z j = δ * z k at h
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, x]
    simpa [mul_comm] using (show (∑ j, (D k j : ℝ) * (z j : ℝ)) = (δ : ℝ) * (z k : ℝ) by exact_mod_cast h)
  have belongs : (δ : ℝ) • (U *ᵥ x) ∈ S := by
    rw [← Matrix.mulVec_smul, ← comb, Matrix.mulVec_sum]
    exact S.sum_mem (fun j _ => by
      rw [Matrix.mulVec_smul]
      exact S.smul_mem _ (Submodule.subset_span ⟨j, rfl⟩))
  have nz : (δ : ℝ) ≠ 0 := by exact_mod_cast nonzero
  change U *ᵥ x ∈ S
  simpa only [smul_smul, inv_mul_cancel₀ nz, one_smul] using S.smul_mem (δ : ℝ)⁻¹ belongs


omit [Fintype κ] [DecidableEq κ] in
theorem incidence_pivot_of_column_span {F : Type*} [Field F] (A : Matrix ι κ ℤ)
    (sp : Submodule.span F (Set.range (fun j i => (A i j : F))) = ⊤) :
    ∃ pick : ι → κ, (A.submatrix id pick).det ≠ 0 := by
  classical
  let base := Pi.basisFun ℤ ι
  let obs : (ι → ℤ) →ₗ[ℤ] (ι → F) := {
    toFun := fun x i => (x i : F)
    map_add' := by intros; ext; simp
    map_smul' := by intros; ext; simp [zsmul_eq_mul] }
  obtain ⟨pick,h⟩ := integer_minor_of_field_span base (fun j i => A i j) obs sp
  refine ⟨pick, ?_⟩
  have eq : base.toMatrix (fun j i => A i (pick j)) = A.submatrix id pick := by
    ext i j
    simp [base, Module.Basis.toMatrix_apply]
  rwa [eq] at h


omit [DecidableEq κ] in
/-- A positive certificate on the joint rows guarantees a nonzero integer
incidence pivot. The selected minor uses only columns of the original matrix. -/
theorem incidence_pivot_from_positive_gram {ν : Type*} [Fintype ν]
    (A : Matrix ι κ ℤ) (scale : ι → ℝ) (hs : ∀ i, scale i ≠ 0) (U : Matrix ν κ ℝ)
    (W : Matrix κ κ ℝ)
    (cert : let M := jointRows A scale U; (M * W * M.transpose).PosDef) :
    ∃ pick : ι → κ, (A.submatrix id pick).det ≠ 0 := by
  classical
  let S := Submodule.span ℝ (Set.range (fun j i => (A i j : ℝ)))
  have sp : S = ⊤ := by
    apply top_unique
    intro b _
    let M := jointRows A scale U
    obtain ⟨x, hx⟩ := weighted_gram_surjective M W cert
      (Sum.elim (fun i => scale i * b i) (fun _ => 0))
    have comb : ∑ j, x j • (fun i => (A i j : ℝ)) = b := by
      funext i
      have hi := congrFun hx (.inl i)
      change ∑ j, scale i * (A i j : ℝ) * x j = scale i * b i at hi
      simp only [mul_assoc, ← Finset.mul_sum] at hi
      simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm] using
        mul_left_cancel₀ (hs i) hi
    rw [← comb]
    exact S.sum_mem (fun j _ => S.smul_mem _ (Submodule.subset_span ⟨j,rfl⟩))
  exact incidence_pivot_of_column_span A sp

/-- The cofactor matrix has zero columns at the pivots. Only free columns
need to be visited when selecting the independent units. -/
theorem pivotKernel_pivot (A : Matrix ι κ ℤ) (pick : ι → κ) (i : ι) (k : κ) :
    pivotKernel A pick k (pick i) = 0 := by
  let B := A.submatrix id pick
  let S := pivotSelector pick
  have zero : pivotKernel A pick * S = 0 := by
    change (B.det • (1 : Matrix κ κ ℤ) - S * B.adjugate * A) * S = 0
    rw [Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul, Matrix.mul_assoc, mul_pivotSelector,
      Matrix.mul_assoc, Matrix.adjugate_mul, Matrix.mul_smul, Matrix.mul_one, sub_self]
  change pivotKernel A pick * pivotSelector pick = 0 at zero
  rw [mul_pivotSelector] at zero
  exact congrArg (fun M : Matrix κ ι ℤ => M k i) zero

/-- The projected free columns alone span the required real unit observations. -/
theorem pivot_free_columns_span {ν : Type*} (A : Matrix ι κ ℤ) (pick : ι → κ)
    (nonzero : (A.submatrix id pick).det ≠ 0) (U : Matrix ν κ ℝ)
    (span : Submodule.span ℝ {y : ν → ℝ | ∃ z : κ → ℤ, A *ᵥ z = 0 ∧
      y = U *ᵥ (fun j => (z j : ℝ))} = ⊤) :
    Submodule.span ℝ (Set.range (fun j : {j // j ∉ Set.range pick} => U *ᵥ
      (fun k => (pivotKernel A pick k j.val : ℝ)))) = ⊤ := by
  classical
  rw [← top_le_iff, ← pivot_columns_span A pick nonzero U span]
  apply Submodule.span_le.mpr
  rintro _ ⟨j,rfl⟩
  by_cases free : j ∉ Set.range pick
  · exact Submodule.subset_span ⟨⟨j,free⟩,rfl⟩
  · obtain ⟨i,rfl⟩ := not_not.mp free
    simp only [pivotKernel_pivot, Int.cast_zero]
    change U *ᵥ (0 : κ → ℝ) ∈ _
    rw [Matrix.mulVec_zero]
    exact Submodule.zero_mem _


omit [Fintype ι] [DecidableEq ι] [DecidableEq κ] in
theorem select_clean_unit_columns_in_basis {K₁ K₂ α β J ν : Type*} [Field K₁] [Field K₂]
    [NumberField K₁] [NumberField K₂] [Fintype α] [Fintype β] [Fintype ν] [DecidableEq ν]
    (basis : Module.Basis ν ℤ (UnitClass K₁ × UnitClass K₂))
    (σ₁ : α → K₁ →+* ℝ) (σ₂ : β → K₂ →+* ℝ) (a : κ → ℤ) (V : Matrix ι κ ℤ)
    (f₁ f₂ : Polynomial ℤ) (θ₁ : K₁) (θ₂ : K₂)
    (root₁ : f₁.eval₂ (Int.castRingHom K₁) θ₁ = 0)
    (root₂ : f₂.eval₂ (Int.castRingHom K₂) θ₂ = 0)
    (rows₁ : AffineMarkRows f₁ a V) (rows₂ : AffineMarkRows f₂ a V)
    (top : ι) (intercept : ∀ j, V top j = 1) (A : ℝ) (hA : 0 < A)
    (H : Matrix ν (α ⊕ β) ℝ) (D : J → κ → ℤ)
    (null : ∀ k i, ∑ j, V i j * D k j = 0)
    (span : let U := H * markLogs σ₁ σ₂ (fun j => (a j : K₁)-θ₁) (fun j => (a j : K₂)-θ₂) A
            Submodule.span ℝ (Set.range (fun k => U *ᵥ (fun j => (D k j : ℝ)))) = ⊤) :
    ∃ (free : ν → J) (u₁ : ν → (𝓞 K₁)ˣ)
      (u₂ : ν → (𝓞 K₂)ˣ),
      (∀ k, (u₁ k : K₁) = ∏ j, ((a j : K₁)-θ₁)^(D (free k) j)) ∧
      (∀ k, (u₂ k : K₂) = ∏ j, ((a j : K₂)-θ₂)^(D (free k) j)) ∧
      (basis.toMatrix (fun k => (unitClass (u₁ k), unitClass (u₂ k)))).det ≠ 0 := by
  classical
  let a₁ (j) := (a j : K₁)-θ₁
  let a₂ (j) := (a j : K₂)-θ₂
  let U := H * markLogs σ₁ σ₂ a₁ a₂ A
  have pair (k : J) : ∃ (u₁ : (𝓞 K₁)ˣ) (u₂ : (𝓞 K₂)ˣ),
      (u₁ : K₁) = ∏ j, (a₁ j)^(D k j) ∧ (u₂ : K₂) = ∏ j, (a₂ j)^(D k j) := by
    obtain ⟨p,hp⟩ := rows₁.neutral_unit θ₁ root₁ top intercept _ (null k)
    obtain ⟨q,hq⟩ := rows₂.neutral_unit θ₂ root₂ top intercept _ (null k)
    exact ⟨p,q,hp,hq⟩
  choose p q hp hq using pair
  let obs := observeUnitPair σ₁ σ₂ H
  have obs_eq (k : J) : obs (unitClass (p k), unitClass (q k)) = U *ᵥ (fun j => (D k j : ℝ)) := by
    have balance : ∑ j, D k j = 0 := by simpa [intercept] using null k top
    exact observed_unit_relations σ₁ σ₂ a₁ a₂ (rows₁.nonzero_marks θ₁ root₁)
      (rows₂.nonzero_marks θ₂ root₂) A hA H _ balance _ _ (hp k) (hq k)
  obtain ⟨free, det⟩ := integer_minor_of_real_span basis
    (fun k => (unitClass (p k), unitClass (q k))) obs (by simpa only [obs_eq] using span)
  exact ⟨free,fun k => p (free k),fun k => q (free k),fun k => hp (free k),fun k => hq (free k),det⟩

omit [Fintype ι] [DecidableEq ι] [DecidableEq κ] in
/-- Specialization to the canonical paired Dirichlet basis. -/
theorem select_clean_unit_columns {K₁ K₂ α β J : Type*} [Field K₁] [Field K₂]
    [NumberField K₁] [NumberField K₂] [Fintype α] [Fintype β]
    (σ₁ : α → K₁ →+* ℝ) (σ₂ : β → K₂ →+* ℝ) (a : κ → ℤ) (V : Matrix ι κ ℤ)
    (f₁ f₂ : Polynomial ℤ) (θ₁ : K₁) (θ₂ : K₂)
    (root₁ : f₁.eval₂ (Int.castRingHom K₁) θ₁ = 0)
    (root₂ : f₂.eval₂ (Int.castRingHom K₂) θ₂ = 0)
    (rows₁ : AffineMarkRows f₁ a V) (rows₂ : AffineMarkRows f₂ a V)
    (top : ι) (intercept : ∀ j, V top j = 1) (A : ℝ) (hA : 0 < A)
    (H : Matrix (UnitRankRows K₁ K₂) (α ⊕ β) ℝ) (D : J → κ → ℤ)
    (null : ∀ k i, ∑ j, V i j * D k j = 0)
    (span : let U := H * markLogs σ₁ σ₂ (fun j => (a j : K₁)-θ₁) (fun j => (a j : K₂)-θ₂) A
            Submodule.span ℝ (Set.range (fun k => U *ᵥ (fun j => (D k j : ℝ)))) = ⊤) :
    ∃ (free : UnitRankRows K₁ K₂ → J) (u₁ : UnitRankRows K₁ K₂ → (𝓞 K₁)ˣ)
      (u₂ : UnitRankRows K₁ K₂ → (𝓞 K₂)ˣ),
      (∀ k, (u₁ k : K₁) = ∏ j, ((a j : K₁)-θ₁)^(D (free k) j)) ∧
      (∀ k, (u₂ k : K₂) = ∏ j, ((a j : K₂)-θ₂)^(D (free k) j)) ∧
      ((pairedUnitBasis K₁ K₂).toMatrix (fun k => (unitClass (u₁ k), unitClass (u₂ k)))).det ≠ 0 := by
  exact select_clean_unit_columns_in_basis (pairedUnitBasis K₁ K₂) σ₁ σ₂ a V f₁ f₂ θ₁ θ₂ root₁ root₂
    rows₁ rows₂ top intercept A hA H D null span

/-- The joint Gram supplies both a bounded target solution and independent field
units among the bounded free columns of the same pivot, in the paired
Dirichlet basis. The size bound uses only the number of integer rows. -/
theorem bounded_clean_affine_pivot_minor {K₁ K₂ α β : Type*} [Field K₁] [Field K₂]
    [NumberField K₁] [NumberField K₂] [Fintype α] [Fintype β]
    (σ₁ : α → K₁ →+* ℝ) (σ₂ : β → K₂ →+* ℝ) (a : κ → ℤ) (V : Matrix ι κ ℤ)
    (f₁ f₂ : Polynomial ℤ) (θ₁ : K₁) (θ₂ : K₂)
    (root₁ : f₁.eval₂ (Int.castRingHom K₁) θ₁ = 0)
    (root₂ : f₂.eval₂ (Int.castRingHom K₂) θ₂ = 0)
    (rows₁ : AffineMarkRows f₁ a V) (rows₂ : AffineMarkRows f₂ a V)
    (top : ι) (intercept : ∀ j, V top j = 1) (hV : ∀ i j, |V i j| ≤ 1)
    (A : ℝ) (hA : 0 < A) (H : Matrix (UnitRankRows K₁ K₂) (α ⊕ β) ℝ)
    (scale : ι → ℝ) (hs : ∀ i, scale i ≠ 0) (W : Matrix κ κ ℝ)
    (cert : let U := H * markLogs σ₁ σ₂ (fun j => (a j : K₁)-θ₁) (fun j => (a j : K₂)-θ₂) A
            let M := jointRows V scale U
            (M * W * M.transpose).PosDef) (target : ι → ℤ) (ht : ∀ i, |target i| ≤ 1) :
    ∃ (pick : ι → κ) (E : ℕ) (c : κ → ℤ)
      (choose : UnitRankRows K₁ K₂ → {j // j ∉ Set.range pick})
      (u₁ : UnitRankRows K₁ K₂ → (𝓞 K₁)ˣ) (u₂ : UnitRankRows K₁ K₂ → (𝓞 K₂)ˣ),
      (V.submatrix id pick).det ≠ 0 ∧ 0 < E ∧ E ≤ (Fintype.card ι).factorial ∧
      (∀ j, |c j| ≤ (Fintype.card ι : ℤ) * (Fintype.card ι).factorial) ∧
      V *ᵥ c = -(E : ℤ) • target ∧
      (∀ k j, |pivotKernel V pick j (choose k).val| ≤
        (Fintype.card ι + 1 : ℤ) * (Fintype.card ι).factorial) ∧
      (∀ k, (u₁ k : K₁) = ∏ j, ((a j : K₁)-θ₁)^(pivotKernel V pick j (choose k).val)) ∧
      (∀ k, (u₂ k : K₂) = ∏ j, ((a j : K₂)-θ₂)^(pivotKernel V pick j (choose k).val)) ∧
      ((pairedUnitBasis K₁ K₂).toMatrix (fun k => (unitClass (u₁ k), unitClass (u₂ k)))).det ≠ 0 := by
  classical
  let a₁ (j) := (a j : K₁)-θ₁
  let a₂ (j) := (a j : K₂)-θ₂
  let U := H * markLogs σ₁ σ₂ a₁ a₂ A
  obtain ⟨pick, nz⟩ := incidence_pivot_from_positive_gram V scale hs U W cert
  obtain ⟨E,c,hE,hsize,hc,eq⟩ := bounded_pivot_target V hV pick nz target ht
  let D := pivotKernel V pick
  have null (k : κ) (i) : ∑ j, V i j * D j k = 0 :=
    congrArg (fun M : Matrix ι κ ℤ => M i k) (mul_pivotKernel V pick)
  have zspan := (positive_gram_descent V scale hs U W cert).2
  have span := pivot_free_columns_span V pick nz U (by
    simpa only [funext_iff, Matrix.mulVec, dotProduct, Pi.zero_apply] using zspan)
  obtain ⟨free,p,q,hp,hq,det⟩ := select_clean_unit_columns σ₁ σ₂ a V f₁ f₂ θ₁ θ₂
    root₁ root₂ rows₁ rows₂ top intercept A hA H
    (fun (k : {j // j ∉ Set.range pick}) j => D j k.val) (fun k => null k.val) span
  exact ⟨pick,E,c,free,p,q,nz,hE,hsize,hc,eq,
    fun k j => pivotKernel_bound V hV pick j _,hp,hq,det⟩

omit [DecidableEq κ] in
/-- Even when restoring discarded rows creates dependencies, a rank-size
submatrix preserves the real kernel and has a nonzero integer pivot. -/
theorem full_incidence_rank_profile {τ : Type*} [Fintype τ] (V : Matrix τ κ ℤ) :
    ∃ r ≤ Fintype.card τ, ∃ (keep : Fin r → τ) (pick : Fin r → κ),
      ((V.submatrix keep id).submatrix id pick).det ≠ 0 ∧
      ∀ x : κ → ℝ, ((V.submatrix keep id).map (Int.castRingHom ℝ)) *ᵥ x = 0 →
        (V.map (Int.castRingHom ℝ)) *ᵥ x = 0 := by
  classical
  let M := V.map (Int.castRingHom ℝ)
  let W := Submodule.span ℝ (Set.range M.row)
  let r := Module.finrank ℝ W
  obtain ⟨f, mem, hspan, hind⟩ := Submodule.exists_fun_fin_finrank_span_eq ℝ (Set.range M.row)
  choose keep hkeep using mem
  let A := V.submatrix keep id
  let R := A.map (Int.castRingHom ℝ)
  have roweq : R.row = f := funext hkeep
  have hil : LinearIndependent ℝ R.row := roweq ▸ hind
  have rr : r ≤ Fintype.card τ := by
    change Module.finrank ℝ (Submodule.span ℝ (Set.range M.row)) ≤ _
    rw [← M.rank_eq_finrank_span_row]
    exact M.rank_le_card_height
  have colSpan : Submodule.span ℝ (Set.range R.col) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [← R.rank_eq_finrank_span_cols, hil.rank_matrix, Module.finrank_pi]
  obtain ⟨pick, nz⟩ := incidence_pivot_of_column_span A colSpan
  refine ⟨r, rr, keep, pick, nz, ?_⟩
  intro x hx
  let dot : (κ → ℝ) →ₗ[ℝ] ℝ := ∑ j, x j • LinearMap.proj j
  have dot_eq (y : κ → ℝ) : dot y = ∑ j, y j * x j := by
    simp [dot, mul_comm]
  have lo : Submodule.span ℝ (Set.range R.row) ≤ dot.ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j,rfl⟩
    change dot (R.row j) = 0
    rw [dot_eq]
    exact congrFun hx j
  rw [roweq, hspan] at lo
  ext i
  have eq := lo (Submodule.subset_span (Set.mem_range_self i))
  change dot (M.row i) = 0 at eq
  exact (dot_eq _).symm.trans eq


omit [Fintype ι] [DecidableEq ι] [DecidableEq κ] in
/-- A pivot solve restricted to independent rows meets all the old integer
equations for every rationally feasible target, also for the zero target. -/
theorem lift_rank_profile_solution {τ : Type*} (V : Matrix τ κ ℤ) (keep : ι → τ)
    (ker : ∀ x : κ → ℝ, ((V.submatrix keep id).map (Int.castRingHom ℝ)) *ᵥ x = 0 →
      (V.map (Int.castRingHom ℝ)) *ᵥ x = 0)
    (b : τ → ℤ) (feasible : ∃ q : κ → ℚ, ∀ i, ∑ j, (V i j : ℚ) * q j = b i)
    (e : ℤ) (c : κ → ℤ) (trial : (V.submatrix keep id) *ᵥ c = e • (b ∘ keep)) :
    V *ᵥ c = e • b := by
  classical
  obtain ⟨q,hq⟩ := feasible
  let z (j) := (c j : ℝ) - (e : ℝ) * (q j : ℝ)
  have target (i) : ∑ j, (V i j : ℝ) * (q j : ℝ) = (b i : ℝ) := by exact_mod_cast hq i
  have expand (i) : ∑ j, (V i j : ℝ) * z j =
      (∑ j, (V i j : ℝ) * (c j : ℝ)) - (e : ℝ) * (b i : ℝ) := by
    simp only [z, mul_sub, Finset.sum_sub_distrib, mul_left_comm (V i _ : ℝ) (e : ℝ),
      ← Finset.mul_sum, target]
  have restricted : ((V.submatrix keep id).map (Int.castRingHom ℝ)) *ᵥ z = 0 := by
    funext k
    change ∑ j, (V (keep k) j : ℝ) * z j = 0
    rw [expand, sub_eq_zero]
    have h := congrFun trial k
    change ∑ j, V (keep k) j * c j = e * b (keep k) at h
    exact_mod_cast h
  have full := ker z restricted
  funext i
  have h := congrFun full i
  change ∑ j, (V i j : ℝ) * z j = 0 at h
  rw [expand, sub_eq_zero] at h
  change ∑ j, V i j * c j = e * b i
  exact_mod_cast h


omit [DecidableEq ι] in
/-- Bounded Step 2 after all clean rows and marks have been restored. The
hypotheses on the target and archimedean image are precisely the conclusions
of the surviving Gram descent, and the full matrix may have dependent rows. -/
theorem bounded_full_affine_pivot_minor {K₁ K₂ α β : Type*} [Field K₁] [Field K₂]
    [NumberField K₁] [NumberField K₂] [Fintype α] [Fintype β]
    (σ₁ : α → K₁ →+* ℝ) (σ₂ : β → K₂ →+* ℝ) (a : κ → ℤ) (V : Matrix ι κ ℤ)
    (f₁ f₂ : Polynomial ℤ) (θ₁ : K₁) (θ₂ : K₂)
    (root₁ : f₁.eval₂ (Int.castRingHom K₁) θ₁ = 0)
    (root₂ : f₂.eval₂ (Int.castRingHom K₂) θ₂ = 0)
    (rows₁ : AffineMarkRows f₁ a V) (rows₂ : AffineMarkRows f₂ a V)
    (top : ι) (intercept : ∀ j, V top j = 1) (hV : ∀ i j, |V i j| ≤ 1)
    (A : ℝ) (hA : 0 < A) (H : Matrix (UnitRankRows K₁ K₂) (α ⊕ β) ℝ)
    (target : ι → ℤ) (ht : ∀ i, |target i| ≤ 1)
    (feasible : ∃ q : κ → ℚ, ∀ i, ∑ j, (V i j : ℚ) * q j = target i)
    (span : let U := H * markLogs σ₁ σ₂ (fun j => (a j : K₁)-θ₁) (fun j => (a j : K₂)-θ₂) A
            Submodule.span ℝ {y : UnitRankRows K₁ K₂ → ℝ | ∃ z : κ → ℤ,
              (∀ i, ∑ j, V i j * z j = 0) ∧ y = U *ᵥ (fun j => (z j : ℝ))} = ⊤) :
    ∃ r ≤ Fintype.card ι, ∃ (keep : Fin r → ι) (pick : Fin r → κ) (E : ℕ) (c : κ → ℤ)
      (choose : UnitRankRows K₁ K₂ → {j // j ∉ Set.range pick})
      (u₁ : UnitRankRows K₁ K₂ → (𝓞 K₁)ˣ) (u₂ : UnitRankRows K₁ K₂ → (𝓞 K₂)ˣ),
      let M := V.submatrix keep id
      (M.submatrix id pick).det ≠ 0 ∧ 0 < E ∧ E ≤ r.factorial ∧
      (∀ j, |c j| ≤ (r : ℤ) * r.factorial) ∧ V *ᵥ c = -(E : ℤ) • target ∧
      (∀ k j, |pivotKernel M pick j (choose k).val| ≤ (r + 1 : ℤ) * r.factorial) ∧
      (∀ k, (u₁ k : K₁) = ∏ j, ((a j : K₁)-θ₁)^(pivotKernel M pick j (choose k).val)) ∧
      (∀ k, (u₂ k : K₂) = ∏ j, ((a j : K₂)-θ₂)^(pivotKernel M pick j (choose k).val)) ∧
      ((pairedUnitBasis K₁ K₂).toMatrix (fun k => (unitClass (u₁ k), unitClass (u₂ k)))).det ≠ 0 := by
  classical
  let U := H * markLogs σ₁ σ₂ (fun j => (a j : K₁)-θ₁) (fun j => (a j : K₂)-θ₂) A
  obtain ⟨r,hr,keep,pick,nz,ker⟩ := full_incidence_rank_profile V
  let M := V.submatrix keep id
  let D := pivotKernel M pick
  have msize (i j) : |M i j| ≤ 1 := hV _ _
  obtain ⟨E,c,hE,he,hc,eq⟩ := bounded_pivot_target M msize pick nz (target ∘ keep) (fun i => ht _)
  have full := lift_rank_profile_solution V keep ker target feasible _ c eq
  have null (k : κ) (i) : ∑ j, V i j * D j k = 0 := by
    have reduced : M *ᵥ (fun j => D j k) = (0 : Fin r → ℤ) := by
      funext i
      exact congrArg (fun Z : Matrix (Fin r) κ ℤ => Z i k) (mul_pivotKernel M pick)
    have lift := lift_rank_profile_solution V keep ker (0 : ι → ℤ)
      ⟨0, by simp⟩ 0 (fun j => D j k) (by simpa using reduced)
    simpa only [zero_smul, Pi.zero_apply, Matrix.mulVec, dotProduct] using congrFun lift i
  have restricted : Submodule.span ℝ {y : UnitRankRows K₁ K₂ → ℝ | ∃ z : κ → ℤ,
      M *ᵥ z = 0 ∧ y = U *ᵥ (fun j => (z j : ℝ))} = ⊤ := by
    rw [← top_le_iff, ← span]
    apply Submodule.span_le.mpr
    rintro _ ⟨z,hz,rfl⟩
    exact Submodule.subset_span ⟨z,funext (fun i => hz (keep i)),rfl⟩
  have freeSpan := pivot_free_columns_span M pick nz U restricted
  obtain ⟨free,p,q,hp,hq,det⟩ := select_clean_unit_columns σ₁ σ₂ a V f₁ f₂ θ₁ θ₂
    root₁ root₂ rows₁ rows₂ top intercept A hA H
    (fun (k : {j // j ∉ Set.range pick}) j => D j k.val) (fun k => null k.val) freeSpan
  refine ⟨r,hr,keep,pick,E,c,free,p,q,nz,hE,by simpa using he,by simpa using hc,full,?_,hp,hq,det⟩
  intro k j
  simpa using pivotKernel_bound M msize pick j (free k).val

end Cogentic
